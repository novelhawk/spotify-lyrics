# Spotify / Discord Authentication
DISCORD_ACCESS_TOKEN=your_discord_access_token_here
USER_ID=your_spotify_user_id_here

# LRCLIB Lyrics Source Configuration (https://lrclib.net/docs)
LRCLIB_BASE_URL=https://lrclib.net
LRCLIB_USER_AGENT=spotify-lyrics/0.1.0 (https://github.com/novelhawk/spotify-lyrics)
ENABLE_LRCLIB_SOURCE=true

# Legacy Lyrix Lyrics Source Configuration (Disabled by default)
ENABLE_LYRIX_SOURCE=false
LYRIX_BASE_URL=https://lyrix.vercel.app

# UI Configuration
ALERT_DURATION_SECS=5
